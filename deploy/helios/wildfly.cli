embed-server --server-config=standalone.xml --std-out=echo
if (outcome != success) of /subsystem=elytron/key-store=labKeyStore:read-resource
    /subsystem=elytron/key-store=labKeyStore:add(path="${env.SOA_HOME}/tls/manager/server.p12",type=PKCS12,credential-reference={clear-text=localchangeit})
end-if
if (outcome != success) of /subsystem=elytron/key-manager=labKeyManager:read-resource
    /subsystem=elytron/key-manager=labKeyManager:add(key-store=labKeyStore,credential-reference={clear-text=localchangeit})
end-if
if (outcome != success) of /subsystem=elytron/server-ssl-context=labSslContext:read-resource
    /subsystem=elytron/server-ssl-context=labSslContext:add(key-manager=labKeyManager,protocols=[TLSv1.3,TLSv1.2])
end-if
/subsystem=undertow/server=default-server/https-listener=https:write-attribute(name=ssl-context,value=labSslContext)
/subsystem=remoting/http-connector=http-remoting-connector:write-attribute(name=connector-ref,value=https)
if (outcome == success) of /subsystem=undertow/server=default-server/http-listener=default:read-resource
    /subsystem=undertow/server=default-server/http-listener=default:remove
end-if
/socket-binding-group=standard-sockets/socket-binding=https:write-attribute(name=port,value="${env.MANAGER_PORT}")
/socket-binding-group=standard-sockets/socket-binding=management-http:write-attribute(name=port,value="${env.WILDFLY_ADMIN_PORT}")
/socket-binding-group=standard-sockets/socket-binding=txn-recovery-environment:write-attribute(name=port,value="${env.MANAGER_RECOVERY_PORT}")
/socket-binding-group=standard-sockets/socket-binding=txn-status-manager:write-attribute(name=port,value="${env.MANAGER_STATUS_PORT}")
/interface=public:write-attribute(name=inet-address,value=127.0.0.1)
/interface=management:write-attribute(name=inet-address,value=127.0.0.1)
/subsystem=io/worker=default:write-attribute(name=io-threads,value=2)
/subsystem=io/worker=default:write-attribute(name=task-max-threads,value=16)
/subsystem=deployment-scanner/scanner=default:write-attribute(name=auto-deploy-zipped,value=false)
stop-embedded-server
